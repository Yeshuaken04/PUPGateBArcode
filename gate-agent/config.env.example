# ============================================================================
# RASPBERRY PI GATE CONTROLLER AGENT CONFIGURATION
# ============================================================================

# Cloud Netlify App URL (Production deployment)
SERVER_URL=https://your-netlify-site.netlify.app

# Gate Identification
GATE_CODE=GATE-01
GATE_DIRECTION=entry

# Device Secret Token (Must match GATE_API_SECRET in Netlify environment variables)
GATE_API_SECRET=pup_bataan_gate_device_secret_secure_key_2026

# Local Hardware Relay Configuration
RELAY_GPIO_PIN=18
RELAY_PULSE_SECONDS=0.8
MOCK_RELAY=false

# Local SQLite Database Path
SQLITE_DB_PATH=database.db
