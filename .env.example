# ============================================================================
# PUP BATAAN AUTOMATED GATE SYSTEM - ENVIRONMENT VARIABLES
# ============================================================================
# IMPORTANT: DO NOT commit your actual .env.local with real secrets to GitHub!
# Set these variables in Netlify -> Site configuration -> Environment variables

# 1. Supabase Project Settings (Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key-here

# 2. Gate Device API Secret (For Raspberry Pi / ESP32 Hardware Authentication)
# Make this a long, secure random secret (e.g. openssl rand -hex 32)
GATE_API_SECRET=pup_bataan_gate_device_secret_secure_key_2026

# 3. Base App URL
NEXT_PUBLIC_APP_URL=https://pup-bataan-gate.netlify.app
